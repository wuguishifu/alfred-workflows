				<string>set -euo pipefail

# Alfred workflow variable passed as environment variable
email="$email_base"

if [[ -z "$email" ]]; then
  echo "ERROR: email_base is not set in Alfred Workflow variables." &gt;&amp;2
  exit 1
fi

# Timestamp YYYYMMDDhhmmss
timestamp="$(date +"%Y%m%d%H%M%S")"

# Split local and domain parts
local_part="${email%@*}"
domain_part="${email#*@}"

# Output result to Alfred without trailing newline
printf "%s+%s@%s" "$local_part" "$timestamp" "$domain_part"</string>
